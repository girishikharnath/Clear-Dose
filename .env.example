# APP_URL: The URL where this applet is hosted (injected automatically at runtime).
# Used for Telegram Bot webhook registration: ${APP_URL}/api/telegram/webhook
APP_URL="MY_APP_URL"

# ==============================================================================
# Messaging Channel API Configuration (Add in AI Studio Secrets panel or .env)
# ==============================================================================

# Telegram Bot API (Create a bot via @BotFather on Telegram to obtain this token)
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_FROM_BOTFATHER"

# Optional secret token to verify incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET="YOUR_OPTIONAL_TELEGRAM_WEBHOOK_SECRET"

# Optional WhatsApp Cloud API credentials (Meta Developers Console)
WHATSAPP_API_TOKEN="YOUR_WHATSAPP_CLOUD_API_TOKEN"
WHATSAPP_PHONE_NUMBER_ID="YOUR_WHATSAPP_PHONE_NUMBER_ID"
